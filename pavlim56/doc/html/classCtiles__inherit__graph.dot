digraph "Ctiles"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Ctiles",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Parent class for tiles."];
  Node1 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="CMapTiles",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCMapTiles.html",tooltip="Parent class for all map tiles."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="Cempty_space",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCempty__space.html",tooltip="tile representing an empty space"];
  Node2 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="Cwall",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCwall.html",tooltip="Tile representing a wall."];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="CUnit",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCUnit.html",tooltip="Parent class for all units."];
  Node5 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node6 [label="Cattacker",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCattacker.html",tooltip="Tile representing the unit attacker."];
  Node5 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node7 [label="Ctower",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCtower.html",tooltip="parent class for all tower types"];
  Node7 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node8 [label="CTowerAOE",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCTowerAOE.html",tooltip="Tile for towers that deal damage in area of effect."];
  Node7 -> Node9 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node9 [label="CTowerObstacle",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCTowerObstacle.html",tooltip="Tile meant to function as a obstacle for attackers."];
  Node7 -> Node10 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node10 [label="CTowerSingleTG",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classCTowerSingleTG.html",tooltip="Tile for towers that target a single attacker."];
}
